# Credentials for the MongoDB container (used by docker compose)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_DB=focuscam

# Only for running a service outside Docker; docker compose builds its own URI
MONGO_URI=mongodb://admin:secret@localhost:27017/focuscam?authSource=admin

# Ports published on the host
WEB_APP_PORT=5000
ML_CLIENT_PORT=8000
